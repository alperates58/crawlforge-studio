generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("operator") // admin, operator, reviewer
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  targetDomain String?
  category     String?
  status       String    @default("active")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  bots         Bot[]
  datasets     Dataset[]
  documents    Document[]
}

model Bot {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  description String?
  startUrl    String?
  stepsJson   String?   // JSON string
  status      String    @default("draft")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  botRuns     BotRun[]
  datasets    Dataset[]
}

enum BotRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model BotRun {
  id               String       @id @default(uuid())
  botId            String
  bot              Bot          @relation(fields: [botId], references: [id])
  status           BotRunStatus @default(queued)
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int?
  pagesVisited     Int          @default(0)
  recordsExtracted Int          @default(0)
  filesDownloaded  Int          @default(0)
  errorMessage     String?
  createdAt        DateTime     @default(now())
  stepLogs         BotStepLog[]
  datasets         Dataset[]
}

model BotStepLog {
  id             String   @id @default(uuid())
  runId          String
  run            BotRun   @relation(fields: [runId], references: [id])
  stepIndex      Int
  stepType       String
  status         String
  message        String?
  dataJson       String?
  screenshotPath String?
  pageIndex      Int?
  itemIndex      Int?
  parentStepIndex Int?
  createdAt      DateTime @default(now())
}

enum DatasetStatus {
  draft
  needs_review
  approved
  rejected
}

model Dataset {
  id              String        @id @default(uuid())
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  botId           String?
  bot             Bot?          @relation(fields: [botId], references: [id])
  runId           String?
  run             BotRun?       @relation(fields: [runId], references: [id])
  sourceUrl       String?
  dataJson        String?
  status          DatasetStatus @default(draft)
  confidenceScore Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  documents       Document[]
  aiJobs          AiJob[]
}

enum DocumentStatus {
  pending
  ready
  failed
}

enum AiJobStatus {
  pending
  running
  completed
  failed
}

enum ReviewStatus {
  needs_review
  approved
  rejected
}

model Document {
  id              String         @id @default(uuid())
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  datasetId       String?
  dataset         Dataset?       @relation(fields: [datasetId], references: [id])
  sourceUrl       String?
  originalUrl     String?
  filename        String
  originalFilename String?
  mimeType        String?
  sizeBytes       Int?
  localPath       String
  extractedText   String?
  aiExtractedJson String?
  status          DocumentStatus @default(pending)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  aiJobs          AiJob[]
}

model AiSetting {
  id              String   @id @default(uuid())
  providerName    String
  baseUrl         String
  encryptedApiKey String
  model           String
  temperature     Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ExtractionSchema {
  id          String   @id @default(uuid())
  name        String
  description String?
  schemaJson  String   // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromptTemplate {
  id                 String   @id @default(uuid())
  name               String
  systemPrompt       String
  userPromptTemplate String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiJob {
  id               String      @id @default(uuid())
  documentId       String?
  datasetId        String?
  schemaId         String
  promptTemplateId String
  providerName     String
  model            String
  status           AiJobStatus @default(pending)
  rawResponse      String?
  structuredJson   String?
  validationErrors String?
  tokenCount       Int?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime    @default(now())

  // Relations
  document         Document?   @relation(fields: [documentId], references: [id])
  dataset          Dataset?    @relation(fields: [datasetId], references: [id])
  extractionResult ExtractionResult?
}

model ExtractionResult {
  id              String       @id @default(uuid())
  aiJobId         String       @unique
  confidenceScore Float?
  jsonData        String?
  reviewStatus    ReviewStatus @default(needs_review)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  aiJob           AiJob        @relation(fields: [aiJobId], references: [id])
}
