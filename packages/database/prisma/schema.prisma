generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("operator") // admin, operator, reviewer
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  targetDomain String?
  category     String?
  status       String    @default("active")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  bots         Bot[]
  datasets     Dataset[]
}

model Bot {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  description String?
  startUrl    String?
  stepsJson   String?   // JSON string
  status      String    @default("draft")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  botRuns     BotRun[]
  datasets    Dataset[]
}

enum BotRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model BotRun {
  id               String       @id @default(uuid())
  botId            String
  bot              Bot          @relation(fields: [botId], references: [id])
  status           BotRunStatus @default(queued)
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int?
  pagesVisited     Int          @default(0)
  recordsExtracted Int          @default(0)
  filesDownloaded  Int          @default(0)
  errorMessage     String?
  createdAt        DateTime     @default(now())
  stepLogs         BotStepLog[]
  datasets         Dataset[]
}

model BotStepLog {
  id             String   @id @default(uuid())
  runId          String
  run            BotRun   @relation(fields: [runId], references: [id])
  stepIndex      Int
  stepType       String
  status         String
  message        String?
  dataJson       String?
  screenshotPath String?
  createdAt      DateTime @default(now())
}

enum DatasetStatus {
  draft
  needs_review
  approved
  rejected
}

model Dataset {
  id              String        @id @default(uuid())
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  botId           String?
  bot             Bot?          @relation(fields: [botId], references: [id])
  runId           String?
  run             BotRun?       @relation(fields: [runId], references: [id])
  sourceUrl       String?
  dataJson        String?
  status          DatasetStatus @default(draft)
  confidenceScore Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
