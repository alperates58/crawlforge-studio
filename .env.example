# App
NODE_ENV=production
APP_NAME=CrawlForge
APP_URL=https://databot.alperates.com.tr
API_URL=https://databot.alperates.com.tr/api

# Auth
JWT_SECRET=change-this-secret

# Database
POSTGRES_USER=crawlforge
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=crawlforge
DATABASE_URL=postgresql://crawlforge:change-this-password@postgres:5432/crawlforge

# Redis
REDIS_URL=redis://redis:6379

# Storage
STORAGE_PATH=/app/storage

# AI Provider - OpenAI compatible
AI_PROVIDER=custom
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=change-this
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.1

# Admin seed
ADMIN_EMAIL=admin@alperates.com.tr
ADMIN_PASSWORD=change-this-admin-password
ENCRYPTION_KEY=change-this-32-byte-secret-key-12
